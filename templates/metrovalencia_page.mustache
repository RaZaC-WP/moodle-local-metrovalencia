{{!
    @template local_metrovalencia/metrovalencia_page

    Station selector and upcoming train forecasts.

    Context variables required for this template:
    * stations - List of stations (id, name, selected)
    * hasstations - Whether there are stations to show
    * forecasts - List of forecasts (time, destination, line, remaining)
    * hasforecasts - Whether there are forecasts to show
    * selectedstation - Name of the selected station

    Example context (json):
    {
        "stations": [
            {"id": 1, "name": "Ayora", "selected": true},
            {"id": 2, "name": "Colón", "selected": false}
        ],
        "hasstations": true,
        "forecasts": [
            {"time": "10:15", "destination": "Bétera", "line": "2", "remaining": "3 min 20 s"}
        ],
        "hasforecasts": true,
        "selectedstation": "Ayora"
    }
}}
<div class="metrovalencia-page">

    <form method="get" action="index.php" class="metrovalencia-form">
        <div class="metrovalencia-station">
            <label for="stationid" class="form-label">
                {{#str}} station_label, local_metrovalencia {{/str}}
            </label>

            <select name="stationid" id="stationid" class="form-select">
                {{#stations}}
                    <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                {{/stations}}
            </select>
        </div>

        <button type="submit" class="btn btn-primary">
            {{#str}} station_submit, local_metrovalencia {{/str}}
        </button>
    </form>

    {{#hasforecasts}}
        <h2 class="metrovalencia-title">
            {{#str}} forecasts_title, local_metrovalencia {{/str}} - <strong>{{selectedstation}}</strong>
        </h2>

        <div class="table-responsive">
            <table class="generaltable">
                <thead>
                    <tr>
                        <th>{{#str}} column_time, local_metrovalencia {{/str}}</th>
                        <th>{{#str}} column_destination, local_metrovalencia {{/str}}</th>
                        <th>{{#str}} column_line, local_metrovalencia {{/str}}</th>
                        <th>{{#str}} column_remaining, local_metrovalencia {{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#forecasts}}
                        <tr>
                            <td>{{time}}</td>
                            <td>{{destination}}</td>
                            <td>{{line}}</td>
                            <td>{{remaining}}</td>
                        </tr>
                    {{/forecasts}}
                </tbody>
            </table>
        </div>
    {{/hasforecasts}}

    {{^hasforecasts}}
        <div class="alert alert-info" role="status">
            {{#str}} forecasts_none, local_metrovalencia {{/str}}
        </div>
    {{/hasforecasts}}

</div>
